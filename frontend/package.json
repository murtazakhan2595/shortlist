{
  "name": "shortlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project component --project rules",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:rules": "vitest run --project rules",
    "test:db": "bash ../supabase/tests/run.sh",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "yield-check": "node --env-file-if-exists=.env.local scripts/himalayas-yield-check.ts",
    "db:types": "supabase gen types --linked --lang=typescript --schema public --workdir .. > src/server/supabase/database.types.ts",
    "model-check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/model-check.ts",
    "queue-check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/queue-check.ts",
    "eval": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/eval.ts",
    "profile:load": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/load-profile.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.0",
    "@langchain/openai": "^1.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.5.0"
}
